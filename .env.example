# Her ikisi de OPSİYONEL. Hiçbiri olmadan da tüm boru hattı çalışır.

# JavaScript ile yüklenen dizin/iletişim sayfaları için.
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Faz 2 sınıflandırma ve Faz 3 kişi çıkarımının otomatik koşması için.
# Yoksa `--backend export` yolu kullanılır (JSONL üretilir, harici olarak işlenir).
LLM_API_KEY=

# Taramada kullanılacak iletişim adresi. Kendi mailini yaz — nazik tarama pratiği,
# site sahibi bir sorun görürse sana ulaşabilir.
CRAWLER_CONTACT_EMAIL=

# Aynı siteye ardışık iki istek arasındaki minimum bekleme (saniye).
REQUEST_DELAY_SECONDS=1.0
